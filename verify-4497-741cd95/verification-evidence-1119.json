    "must": [
      {
        "source": "sglang_omni_mlx/native/src/moss/moss_realtime.cpp:149-159,274-284; moss_transcriber.cpp:483-498",
        "finding": "A cancelled preview is still published when the transcriber returns a successful result instead of throwing GenerationCancelled. The worker preserves successful results, and the real transcriber can return after its last cancellation check.",
        "reproduction": "Hold the 12000-sample preview at a barrier. Stop at 100 ms or append to 64000 samples, then release the barrier with a normal result. Both paths emit is_final=false before the Final. An isolated preview-cancel publication guard makes both harnesses emit only the Final.",
        "required_fix": "Suppress publication when that preview's cancel flag is set, independently of whether transcription throws. Add barrier regressions where cancelled previews return success for stop and full-window preemption; both fail on this exact head."
      }
    ],
    "should": [
      {
        "source": "sglang_omni_mlx/native/tests/moss_realtime_test.cpp:228-253,386-426,457-565",
        "finding": "Cancellation tests rely on real-thread sleeps and a continuously advancing virtual clock. Descheduling can let a preview finish before cancellation and fail a correct implementation.",
        "suggested_test": "Use explicit barriers and manual clock advancement so the cancellation point cannot race natural decode completion."
      }
    ]
  },
